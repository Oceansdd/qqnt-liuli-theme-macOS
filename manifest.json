{
  "manifest_version": 4,
  "type": "extension",
  "name": "琉璃 for macOS",
  "slug": "liuli-dsh-theme",
  "description": "专为 macOS QQNT 打造的琉璃主题，融合经典琉璃、Liquid Glass、MCU 动态取色、自定义聊天气泡与响应式布局。本项目基于原版琉璃开发，由 OpenAI ChatGPT 全程鼎力支持。",
  "version": "1.3.7",
  "icon": "./assets/brand/liuli-icon.png",
  "thumb": "./assets/brand/liuli-sidebar.svg",
  "authors": [
    {
      "name": "LilycleHeart",
      "link": "https://github.com/LilycleHeart"
    },
    {
      "name": "Oceansdd",
      "link": "https://github.com/Oceansdd"
    }
  ],
  "repository": {
    "repo": "Oceansdd/qqnt-liuli-theme-macOS",
    "branch": "liteloader"
  },
  "dependencies": [],
  "platform": ["win32", "linux", "darwin"],
  "injects": {
    "main": "./main/index.js",
    "preload": "./preload/index.js",
    "renderer": "./renderer/index.js"
  }
}
